+
+function upsert<T extends { id: string }>(list: T[], item: T): T[] {
+  const index = list.findIndex((row) => row.id === item.id);
+  if (index === -1) return [item, ...list];
+  const next = list.slice();
+  next[index] = item;
+  return next;
+}
