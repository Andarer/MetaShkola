+  grants: Record<Action, boolean>;
+};
+
+export type Audit = {
+  id: string;
+  at: string;
+  profileId: string;
+  text: string;
+};
+
+export type Screen =
+  | "home"
+  | "schedule"
+  | "tasks"
+  | "calendar"
+  | "more"
+  | "bells"
+  | "ai"
+  | "people"
+  | "orgs"
+  | "integrations"
+  | "settings";
+
+export type OutboxItem = {
+  id: string;
+  at: string;
+  entity: "task" | "lesson" | "grade" | "event" | "profile" | "general";
+  action: "create" | "update" | "delete";
+  summary: string;
+};
+
+export type Data = {
+  version: 1;
+  lang: Lang;
+  theme: Theme;
+  activeProfileId: string;
+  activeSpaceId: string;
+  profiles: Profile[];
+  spaces: Space[];
+  orgs: Org[];
+  divisions: Division[];
+  classes: ClassRoom[];
+  groups: StudyGroup[];
+  subjects: Subject[];
+  periods: Period[];
+  lessons: Lesson[];
+  exceptions: ScheduleException[];
+  tasks: Homework[];
+  grades: Grade[];
+  events: CalEvent[];
+  providers: AiProvider[];
+  assistants: Assistant[];
+  chats: ChatThread[];
+  activeChatId: string | null;
+  usage: Usage[];
+  integrations: Integration[];
+  rules: SyncRule[];
+  syncLog: SyncLog[];
+  inbox: InboxNote[];
+  notif: NotifPrefs;
+  customRoles: CustomRole[];
+  audit: Audit[];
+  outbox: OutboxItem[];
+};
+
+export const defaultBell = (): Bell => ({
+  firstStart: "08:00",
+  lessonMinutes: 45,
+  breakMinutes: 10,
+  bigBreakMinutes: 20,
+  bigBreakAfter: [3],
+  lessonsPerDay: 6,
+});
+
+export const defaultNotif = (): NotifPrefs => ({
+  lessonStart: true,
+  lessonEnd: true,
+  breakStart: true,
+  breakEnd: true,
+  remind15: true,
+  remind5: true,
+  tasks: true,
+  personal: true,
+});
