+import { useEffect, useState } from "react";
+import { Volume2, Settings2, Bell as BellIcon, Check } from "lucide-react";
+import { watchGroups } from "@/lib/ms/agenda";
+import { tf, t } from "@/lib/ms/i18n";
+import { canInSpace } from "@/lib/ms/rbac";
+import { useMs } from "@/lib/ms/store";
+import { dayPhase, formatCountdown, formatHHMM, isoWeekday, minutesNow, resolveDay, toISODate } from "@/lib/ms/time";
+import { Btn, Card, controlClass, Field, Modal, subjectOf, toneBorder } from "@/components/ms/ui";
+import { cn } from "@/lib/cn";
+import type { Bell } from "@/lib/ms/types";
+
+function playBellChime() {
+  try {
+    const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
+    if (!AudioContextClass) return;
+    const ctx = new AudioContextClass();
+    if (ctx.state === "suspended") {
+      ctx.resume().catch(() => {});
+    }
+    const notes = [523.25, 659.25, 783.99, 1046.5]; // C5, E5, G5, C6
+    notes.forEach((freq, idx) => {
+      const osc = ctx.createOscillator();
+      const gain = ctx.createGain();
+      osc.type = "sine";
+      osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.2);
+      gain.gain.setValueAtTime(0.15, ctx.currentTime + idx * 0.2);
+      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.2 + 0.6);
+      osc.connect(gain);
+      gain.connect(ctx.destination);
+      osc.start(ctx.currentTime + idx * 0.2);
+      osc.stop(ctx.currentTime + idx * 0.2 + 0.6);
+    });
+  } catch {
+    // Audio restricted without user interaction
+  }
+}
+
+export function BellsScreen() {
+  const data = useMs((s) => s.data);
+  const updateBell = useMs((s) => s.updateBell);
+  const lang = data.lang;
+  const profile = data.profiles.find((item) => item.id === data.activeProfileId);
+  const groups = watchGroups(data, profile);
+  const [groupId, setGroupId] = useState(groups[0]?.id ?? "");
+  const [now, setNow] = useState(() => new Date());
+  const [bellModalOpen, setBellModalOpen] = useState(false);
+  const [chimePlayed, setChimePlayed] = useState(false);
+
+  useEffect(() => {
+    const timer = window.setInterval(() => setNow(new Date()), 1000);
+    return () => window.clearInterval(timer);
+  }, []);
+
+  const group = groups.find((item) => item.id === groupId) ?? groups[0];
+  const space = data.spaces.find((item) => item.id === group?.spaceId);
+  const canEdit = Boolean(profile && space && canInSpace(profile, space.id, "schedule", data.customRoles));
+
+  if (!group || !space) return <p className="text-sm text-muted">{t(lang, "noLessons")}</p>;
+
+  const date = toISODate(now);
+  const rows = resolveDay(space.bell, data.lessons, data.exceptions, date, isoWeekday(now), {
+    classId: group.teacherId ? undefined : group.classId,
+    ownerProfileId: group.ownerProfileId,
+    teacherId: group.teacherId,
+  });
+  const phase = dayPhase(rows, minutesNow(now));
+  const clock = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}:${String(now.getSeconds()).padStart(2, "0")}`;
+
+  let headline = t(lang, "phaseEmpty");
+  let sub = "";
+  if (phase.kind === "before") {
+    headline = t(lang, "phaseBefore");
+    sub = tf(lang, "bellIn", { t: formatCountdown(phase.mins) });
+  } else if (phase.kind === "lesson") {
+    headline = t(lang, "phaseLesson");
+    sub = tf(lang, "untilEnd", { t: formatCountdown(phase.mins) });
+  } else if (phase.kind === "break") {
+    headline = t(lang, "phaseBreak");
+    sub = tf(lang, "bellIn", { t: formatCountdown(phase.mins) });
+  } else if (phase.kind === "after") {
+    headline = t(lang, "phaseAfter");
+  }
+
+  const handleTestChime = () => {
+    playBellChime();
+    setChimePlayed(true);
+    setTimeout(() => setChimePlayed(false), 2000);
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <header className="flex items-center justify-between gap-3">
+        <h1 className="text-3xl">{t(lang, "bells")}</h1>
+        <div className="flex gap-2">
+          <Btn variant="ghost" onClick={handleTestChime} className="flex items-center gap-1.5 text-xs">
+            {chimePlayed ? <Check className="h-4 w-4 text-sage" /> : <Volume2 className="h-4 w-4 text-copper" />}
+            <span>Прослушать звонок</span>
+          </Btn>
+          {canEdit ? (
+            <Btn variant="ghost" onClick={() => setBellModalOpen(true)} className="flex items-center gap-1.5 text-xs">
+              <Settings2 className="h-4 w-4 text-muted" />
+              <span>Настройка</span>
+            </Btn>
+          ) : null}
+        </div>
+      </header>
+
+      <Field label={t(lang, "myWatch")}>
+        <select className={controlClass} value={group.id} onChange={(event) => setGroupId(event.target.value)}>
+          {groups.map((item) => (
+            <option key={item.id} value={item.id}>{item.label}</option>
+          ))}
+        </select>
+      </Field>
+
+      <Card>
+        <div className="flex items-start justify-between">
+          <div>
+            <p className="font-display text-4xl tabular-nums">{clock}</p>
+            <p className="mt-2 text-lg font-semibold">{headline}</p>
+            {sub ? <p className="text-copper font-medium">{sub}</p> : null}
+          </div>
+          <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-copper/10 text-copper">
+            <BellIcon className="h-6 w-6" />
+          </div>
+        </div>
+
+        <div className="mt-4 grid grid-cols-2 gap-2 border-t border-line/50 pt-3 text-xs sm:grid-cols-4">
+          <div>
+            <p className="text-muted">Первый урок</p>
+            <p className="font-semibold">{space.bell.firstStart}</p>
+          </div>
+          <div>
+            <p className="text-muted">Длительность</p>
+            <p className="font-semibold">{space.bell.lessonMinutes} мин</p>
+          </div>
+          <div>
+            <p className="text-muted">Обычная перемена</p>
+            <p className="font-semibold">{space.bell.breakMinutes} мин</p>
+          </div>
+          <div>
+            <p className="text-muted">Большая перемена</p>
+            <p className="font-semibold">{space.bell.bigBreakMinutes} мин (после {space.bell.bigBreakAfter.join(", ")})</p>
+          </div>
+        </div>
+      </Card>
+
+      <h2 className="text-lg font-semibold mt-1">Звонки на сегодня</h2>
+      {rows.map((row) => {
+        const subject = subjectOf(data, row.subjectId);
+        const current = phase.kind === "lesson" && phase.current.lesson.id === row.lesson.id;
+        return (
+          <div
+            key={row.lesson.id}
+            className={cn(
+              "rounded-2xl border border-line bg-surface p-4 border-l-4 transition-all",
+              toneBorder(subject?.tone),
+              row.cancelled && "opacity-50",
+              current && "ring-2 ring-copper shadow-sm"
+            )}
+          >
+            <div className="flex items-center justify-between">
+              <p className="text-sm tabular-nums font-semibold text-muted">
+                {formatHHMM(row.startMin)} – {formatHHMM(row.endMin)}
+              </p>
+              <span className="rounded-md bg-surface-2 px-2 py-0.5 text-xs text-muted">
+                {row.lesson.index} урок
+              </span>
+            </div>
+            <p className="mt-1 font-semibold text-base">{subject?.name}</p>
+            <p className="text-xs text-muted">{row.cancelled ? t(lang, "cancelled") : (row.room ? `Кабинет ${row.room}` : "—")}</p>
+          </div>
+        );
+      })}
+
+      {canEdit ? (
+        <EditBellModal
+          open={bellModalOpen}
+          bell={space.bell}
+          onClose={() => setBellModalOpen(false)}
+          onSave={(updated) => {
+            updateBell(space.id, updated);
+            setBellModalOpen(false);
+          }}
+        />
+      ) : null}
+    </div>
+  );
+}
+
+function EditBellModal({
+  open,
+  bell,
+  onClose,
+  onSave,
+}: {
+  open: boolean;
+  bell: Bell;
+  onClose: () => void;
+  onSave: (b: Bell) => void;
+}) {
+  const [firstStart, setFirstStart] = useState(bell.firstStart);
+  const [lessonMinutes, setLessonMinutes] = useState(bell.lessonMinutes);
+  const [breakMinutes, setBreakMinutes] = useState(bell.breakMinutes);
+  const [bigBreakMinutes, setBigBreakMinutes] = useState(bell.bigBreakMinutes);
+  const [lessonsPerDay, setLessonsPerDay] = useState(bell.lessonsPerDay);
+
+  if (!open) return null;
+
+  return (
+    <Modal open={open} title="Настройка расписания звонков" onClose={onClose}>
+      <form
+        className="flex flex-col gap-3"
+        onSubmit={(e) => {
+          e.preventDefault();
+          onSave({
+            firstStart,
+            lessonMinutes,
+            breakMinutes,
+            bigBreakMinutes,
+            bigBreakAfter: bell.bigBreakAfter,
+            lessonsPerDay,
+          });
+        }}
+      >
+        <Field label="Начало первого урока">
+          <input
+            className={controlClass}
+            type="time"
+            value={firstStart}
+            onChange={(e) => setFirstStart(e.target.value)}
+            required
+          />
+        </Field>
+        <Field label="Длительность урока (мин)">
+          <input
+            className={controlClass}
+            type="number"
+            min={20}
+            max={90}
+            value={lessonMinutes}
+            onChange={(e) => setLessonMinutes(Number(e.target.value) || 45)}
+            required
+          />
+        </Field>
+        <Field label="Обычная перемена (мин)">
+          <input
+            className={controlClass}
+            type="number"
+            min={5}
+            max={30}
+            value={breakMinutes}
+            onChange={(e) => setBreakMinutes(Number(e.target.value) || 10)}
+            required
+          />
+        </Field>
+        <Field label="Большая перемена (мин)">
+          <input
+            className={controlClass}
+            type="number"
+            min={10}
+            max={45}
+            value={bigBreakMinutes}
+            onChange={(e) => setBigBreakMinutes(Number(e.target.value) || 20)}
+            required
+          />
+        </Field>
+        <Field label="Количество уроков в день">
+          <input
+            className={controlClass}
+            type="number"
+            min={1}
+            max={12}
+            value={lessonsPerDay}
+            onChange={(e) => setLessonsPerDay(Number(e.target.value) || 6)}
+            required
+          />
+        </Field>
+        <Btn type="submit" className="mt-2">
+          Сохранить настройки звонков
+        </Btn>
+      </form>
+    </Modal>
+  );
+}
diff --git a/src/components/ms/calendar-screen.tsx b/src/components/ms/calendar-screen.tsx
new file mode 100644
index 0000000..a2fa547
--- /dev/null
+++ b/src/components/ms/calendar-screen.tsx
@@ -0,0 +1,145 @@
+import { useMemo, useState } from "react";
+import { uid } from "@/lib/ms/id";
+import type { CopyKey } from "@/lib/ms/i18n";
+import { t } from "@/lib/ms/i18n";
+import { canInSpace, canSeeEvent } from "@/lib/ms/rbac";
+import { useMs } from "@/lib/ms/store";
+import { addDays, isoWeekday, startOfDay, toISODate } from "@/lib/ms/time";
+import type { CalEvent, EventKind } from "@/lib/ms/types";
+import { Btn, Card, controlClass, Field, Modal } from "@/components/ms/ui";
+import { cn } from "@/lib/cn";
+
+const KINDS: EventKind[] = ["study", "weekend", "vacation", "holiday", "test", "exam", "event", "personal", "meeting"];
+
+function kindKey(kind: EventKind): CopyKey {
+  return `ev_${kind}` as CopyKey;
+}
+
+export function CalendarScreen() {
+  const data = useMs((s) => s.data);
+  const saveEvent = useMs((s) => s.saveEvent);
+  const removeEvent = useMs((s) => s.removeEvent);
+  const lang = data.lang;
+  const profile = data.profiles.find((item) => item.id === data.activeProfileId);
+  const [cursor, setCursor] = useState(() => startOfDay(new Date()));
+  const [selected, setSelected] = useState(toISODate(new Date()));
+  const [open, setOpen] = useState(false);
+  const canCreate = Boolean(profile && canInSpace(profile, data.activeSpaceId, "create", data.customRoles));
+  const events = data.events.filter((event) => canSeeEvent(data, profile, event));
+  const monthStart = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
+  const gridStart = addDays(monthStart, -(isoWeekday(monthStart) - 1));
+  const days = useMemo(() => Array.from({ length: 42 }, (_, index) => addDays(gridStart, index)), [gridStart]);
+  const selectedEvents = events.filter((event) => event.date <= selected && (event.endDate ?? event.date) >= selected);
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex items-center justify-between gap-2">
+        <h1 className="text-3xl">{t(lang, "calendar")}</h1>
+        {canCreate ? <Btn onClick={() => setOpen(true)}>{t(lang, "add")}</Btn> : null}
+      </div>
+      <div className="flex items-center justify-between">
+        <Btn variant="ghost" onClick={() => setCursor(new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1))}>‹</Btn>
+        <p className="font-semibold tabular-nums">{cursor.getFullYear()}-{String(cursor.getMonth() + 1).padStart(2, "0")}</p>
+        <Btn variant="ghost" onClick={() => setCursor(new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1))}>›</Btn>
+      </div>
+      <div className="grid grid-cols-7 gap-1 text-center text-xs text-muted">
+        {[1, 2, 3, 4, 5, 6, 7].map((day) => (
+          <span key={day}>{t(lang, `wd${day}` as CopyKey).slice(0, 2)}</span>
+        ))}
+      </div>
+      <div className="grid grid-cols-7 gap-1">
+        {days.map((day) => {
+          const iso = toISODate(day);
+          const inMonth = day.getMonth() === cursor.getMonth();
+          const marked = events.some((event) => event.date <= iso && (event.endDate ?? event.date) >= iso);
+          return (
+            <button
+              key={iso}
+              type="button"
+              className={cn(
+                "h-11 rounded-xl text-sm tabular-nums",
+                selected === iso ? "bg-copper text-copper-fg" : "bg-surface text-fg",
+                !inMonth && "opacity-40",
+              )}
+              onClick={() => setSelected(iso)}
+            >
+              {day.getDate()}
+              {marked ? <span className="mt-0.5 block h-1 rounded-full bg-current" /> : null}
+            </button>
+          );
+        })}
+      </div>
+      {selectedEvents.length === 0 ? <p className="text-sm text-muted">{t(lang, "noEvents")}</p> : null}
+      {selectedEvents.map((event) => (
+        <Card key={event.id}>
+          <p className="text-sm text-copper">{t(lang, kindKey(event.kind))}</p>
+          <h2 className="text-xl">{event.title}</h2>
+          {event.note ? <p className="text-sm text-muted">{event.note}</p> : null}
+          {canCreate && event.spaceId === data.activeSpaceId ? (
+            <Btn variant="danger" className="mt-2" onClick={() => removeEvent(event.id)}>{t(lang, "delete")}</Btn>
+          ) : null}
+        </Card>
+      ))}
+      <EventComposer open={open} date={selected} onClose={() => setOpen(false)} onSave={saveEvent} />
+    </div>
+  );
+}
+
+function EventComposer({
+  open,
+  date,
+  onClose,
+  onSave,
+}: {
+  open: boolean;
+  date: string;
+  onClose: () => void;
+  onSave: (event: CalEvent) => void;
+}) {
+  const data = useMs((s) => s.data);
+  const lang = data.lang;
+  const [title, setTitle] = useState("");
+  const [kind, setKind] = useState<EventKind>("personal");
+  const [note, setNote] = useState("");
+  const [endDate, setEndDate] = useState("");
+  const [classId, setClassId] = useState("");
+  if (!open) return null;
+  const classes = data.classes.filter((item) => item.spaceId === data.activeSpaceId);
+  return (
+    <Modal open={open} title={t(lang, "newEvent")} onClose={onClose}>
+      <Field label={t(lang, "title")}><input className={controlClass} value={title} onChange={(event) => setTitle(event.target.value)} /></Field>
+      <Field label={t(lang, "kind")}>
+        <select className={controlClass} value={kind} onChange={(event) => setKind(event.target.value as EventKind)}>
+          {KINDS.map((item) => <option key={item} value={item}>{t(lang, kindKey(item))}</option>)}
+        </select>
+      </Field>
+      <Field label={t(lang, "classLabel")}>
+        <select className={controlClass} value={classId} onChange={(event) => setClassId(event.target.value)}>
+          <option value="">{t(lang, "everyone")}</option>
+          {classes.map((room) => <option key={room.id} value={room.id}>{room.name}</option>)}
+        </select>
+      </Field>
+      <Field label={t(lang, "date")}><input className={controlClass} type="date" value={endDate} onChange={(event) => setEndDate(event.target.value)} /></Field>
+      <Field label={t(lang, "note")}><input className={controlClass} value={note} onChange={(event) => setNote(event.target.value)} /></Field>
+      <Btn
+        disabled={!title.trim()}
+        onClick={() => {
+          onSave({
+            id: uid(),
+            spaceId: data.activeSpaceId,
+            title: title.trim(),
+            date,
+            endDate: endDate || undefined,
+            kind,
+            classId: classId || undefined,
+            profileId: kind === "personal" ? data.activeProfileId : undefined,
+            note,
+          });
+          onClose();
+        }}
+      >
+        {t(lang, "save")}
+      </Btn>
+    </Modal>
+  );
+}
diff --git a/src/components/ms/home-screen.tsx b/src/components/ms/home-screen.tsx
new file mode 100644
index 0000000..5f33356
--- /dev/null
+++ b/src/components/ms/home-screen.tsx
@@ -0,0 +1,138 @@
+import { watchGroups } from "@/lib/ms/agenda";
+import type { CopyKey } from "@/lib/ms/i18n";
+import { t } from "@/lib/ms/i18n";
+import { canInSpace, canSeeGrade, canSeeTask } from "@/lib/ms/rbac";
+import { useMs } from "@/lib/ms/store";
+import { addDays, formatHHMM, isoWeekday, resolveDay, toISODate } from "@/lib/ms/time";
+import type { Screen } from "@/lib/ms/types";
+import { Card, personName, subjectOf, toneBorder } from "@/components/ms/ui";
+import { cn } from "@/lib/cn";
+
+const WEEK: ("mon" | "tue" | "wed" | "thu" | "fri" | "sat" | "sun")[] = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];
+
+export function dayLabel(lang: Parameters<typeof t>[0], offsetLabel: "today" | "tomorrow" | "nextStudy", date: Date): string {
+  return `${t(lang, offsetLabel)} · ${t(lang, WEEK[isoWeekday(date) - 1] ?? "mon")}`;
+}
+
+export function HomeScreen({ onOpen }: { onOpen: (screen: Screen) => void }) {
+  const data = useMs((s) => s.data);
+  const lang = data.lang;
+  const profile = data.profiles.find((item) => item.id === data.activeProfileId);
+  const groups = watchGroups(data, profile).slice(0, 3);
+  const today = new Date();
+  const visibleTasks = data.tasks.filter((task) => canSeeTask(data, profile, task) && task.status !== "checked");
+  const visibleGrades = data.grades.filter((grade) => canSeeGrade(data, profile, grade));
+  const canReports = Boolean(profile && canInSpace(profile, data.activeSpaceId, "reports", data.customRoles));
+  const subjectRows = Object.values(
+    visibleGrades.reduce<Record<string, { id: string; label: string; sum: number; count: number }>>((acc, grade) => {
+      const key = `${grade.studentId}:${grade.subjectId}`;
+      const subject = subjectOf(data, grade.subjectId)?.name ?? t(lang, "subject");
+      const who = personName(data, grade.studentId);
+      const row = acc[key] ?? { id: key, label: `${who} · ${subject}`, sum: 0, count: 0 };
+      row.sum += grade.score;
+      row.count += 1;
+      acc[key] = row;
+      return acc;
+    }, {}),
+  ).sort((a, b) => b.count - a.count);
+
+  return (
+    <div className="flex flex-col gap-4">
+      <header>
+        <h1 className="text-3xl">{profile?.name}</h1>
+        <p className="text-sm text-muted">{data.spaces.find((space) => space.id === data.activeSpaceId)?.name}</p>
+      </header>
+      {groups.map((group) => {
+        let when = today;
+        let rows: ReturnType<typeof resolveDay> = [];
+        for (let offset = 0; offset < 7; offset += 1) {
+          const date = addDays(today, offset);
+          const space = data.spaces.find((item) => item.id === group.spaceId);
+          if (!space) break;
+          const resolved = resolveDay(space.bell, data.lessons, data.exceptions, toISODate(date), isoWeekday(date), {
+            classId: group.teacherId ? undefined : group.classId,
+            ownerProfileId: group.ownerProfileId,
+            teacherId: group.teacherId,
+          }).filter((row) => !row.cancelled);
+          if (resolved.length > 0) {
+            when = date;
+            rows = resolved;
+            break;
+          }
+        }
+        const label =
+          toISODate(when) === toISODate(today)
+            ? "today"
+            : toISODate(when) === toISODate(addDays(today, 1))
+              ? "tomorrow"
+              : "nextStudy";
+        return (
+          <Card key={group.id}>
+            <button type="button" className="flex w-full flex-col gap-3 text-left" onClick={() => onOpen("schedule")}>
+              <div className="flex items-baseline justify-between gap-3">
+                <h2 className="text-xl">{group.label}</h2>
+                <span className="text-sm text-muted">{dayLabel(lang, label, when)}</span>
+              </div>
+              {rows.length === 0 ? <p className="text-sm text-muted">{t(lang, "noLessons")}</p> : null}
+              {rows.slice(0, 4).map((row) => {
+                const subject = subjectOf(data, row.subjectId);
+                return (
+                  <div key={row.lesson.id} className={cn("border-l-4 pl-3", toneBorder(subject?.tone))}>
+                    <p className="text-sm tabular-nums text-muted">
+                      {formatHHMM(row.startMin)}–{formatHHMM(row.endMin)}
+                    </p>
+                    <p className="font-semibold">{subject?.name ?? t(lang, "subject")}</p>
+                    <p className="text-sm text-muted">
+                      {row.room} · {personName(data, row.teacherId)}
+                    </p>
+                  </div>
+                );
+              })}
+            </button>
+          </Card>
+        );
+      })}
+      <Card>
+        <div className="mb-2 flex items-center justify-between">
+          <h2 className="text-xl">{t(lang, "tasks")}</h2>
+          <button type="button" className="text-sm font-semibold text-copper" onClick={() => onOpen("tasks")}>
+            {t(lang, "allTasks")}
+          </button>
+        </div>
+        {visibleTasks.length === 0 ? <p className="text-sm text-muted">{t(lang, "noTasks")}</p> : null}
+        <ul className="flex flex-col gap-3">
+          {visibleTasks
+            .slice()
+            .sort((a, b) => a.due.localeCompare(b.due))
+            .slice(0, 3)
+            .map((task) => (
+              <li key={task.id}>
+                <p className="font-semibold">{task.title}</p>
+                <p className="text-sm text-muted">
+                  {personName(data, task.assigneeId)} · {task.due} · {t(lang, `pr_${task.priority}` as CopyKey)}
+                </p>
+              </li>
+            ))}
+        </ul>
+      </Card>
+      {canReports ? (
+        <Card>
+          <h2 className="text-xl">{t(lang, "reports")}</h2>
+          <p className="mt-2 text-sm text-muted">
+            {t(lang, "openTasks")}: {visibleTasks.length}
+          </p>
+          <h3 className="mt-3 text-lg">{t(lang, "bySubject")}</h3>
+          {subjectRows.length === 0 ? <p className="mt-2 text-sm text-muted">{t(lang, "none")}</p> : null}
+          <ul className="mt-2 flex flex-col gap-2">
+            {subjectRows.slice(0, 8).map((row) => (
+              <li key={row.id} className="flex items-baseline justify-between gap-3 text-sm">
+                <span className="min-w-0 truncate">{row.label}</span>
+                <span className="font-display text-xl tabular-nums">{Math.round((row.sum / row.count) * 10) / 10}</span>
+              </li>
+            ))}
+          </ul>
+        </Card>
+      ) : null}
+    </div>
+  );
+}
diff --git a/src/components/ms/integrations-screen.tsx b/src/components/ms/integrations-screen.tsx
