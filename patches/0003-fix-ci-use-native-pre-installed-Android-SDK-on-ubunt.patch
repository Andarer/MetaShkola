From a89214c04d5731db551e4bc23bde9610e03de685 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?And=C3=A1rer?= <andarer86@gmail.com>
Date: Wed, 4 Nov 2026 15:47:53 +0000
Subject: [PATCH 3/3] fix(ci): use native pre-installed Android SDK on ubuntu
 runner to fix setup-android action failure

---
 .github/workflows/android-ci.yml            |   9 +++++++--
 .github/workflows/release.yml               |   9 +++++++--
 release/MetaShkola-v2.0.1-web.tar.gz        | Bin 0 -> 2628322 bytes
 release/MetaShkola-v2.0.1-web.tar.gz.sha256 |   1 +
 4 files changed, 15 insertions(+), 4 deletions(-)
 create mode 100644 release/MetaShkola-v2.0.1-web.tar.gz
 create mode 100644 release/MetaShkola-v2.0.1-web.tar.gz.sha256

diff --git a/.github/workflows/android-ci.yml b/.github/workflows/android-ci.yml
index 4922966..e4f6f0f 100644
--- a/.github/workflows/android-ci.yml
+++ b/.github/workflows/android-ci.yml
@@ -56,8 +56,13 @@ jobs:
           java-version: 17
           cache: 'gradle'
 
-      - name: Setup Android SDK
-        uses: android-actions/setup-android@v3
+      - name: Configure Android SDK Environment
+        run: |
+          echo "ANDROID_HOME=$ANDROID_HOME" >> $GITHUB_ENV
+          echo "ANDROID_SDK_ROOT=$ANDROID_HOME" >> $GITHUB_ENV
+          echo "$ANDROID_HOME/cmdline-tools/latest/bin" >> $GITHUB_PATH
+          echo "$ANDROID_HOME/platform-tools" >> $GITHUB_PATH
+          yes | sdkmanager --licenses > /dev/null 2>&1 || true
 
       - name: Prepare Gradle Wrapper
         working-directory: android
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 136c2c6..9614b27 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -78,8 +78,13 @@ jobs:
           java-version: 17
           cache: 'gradle'
 
-      - name: Setup Android SDK
-        uses: android-actions/setup-android@v3
+      - name: Configure Android SDK Environment
+        run: |
+          echo "ANDROID_HOME=$ANDROID_HOME" >> $GITHUB_ENV
+          echo "ANDROID_SDK_ROOT=$ANDROID_HOME" >> $GITHUB_ENV
+          echo "$ANDROID_HOME/cmdline-tools/latest/bin" >> $GITHUB_PATH
+          echo "$ANDROID_HOME/platform-tools" >> $GITHUB_PATH
+          yes | sdkmanager --licenses > /dev/null 2>&1 || true
 
       - name: Verify Release Signing Secrets Configuration
         id: check_secrets
